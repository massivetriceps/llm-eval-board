generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  workspaces   Workspace[]
}

model Workspace {
  id           String          @id @default(uuid())
  name         String
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  datasets     Dataset[]
  prompts      PromptVersion[]
  modelConfigs ModelConfig[]

  @@index([ownerId])
}

// 평가 질문 묶음 (CSV: input[, expected])
model Dataset {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime      @default(now())
  items       DatasetItem[]

  @@index([workspaceId])
}

model DatasetItem {
  id        String  @id @default(uuid())
  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  position  Int
  input     String
  expected  String?

  @@index([datasetId, position])
}

// 프롬프트는 수정하지 않고 새 버전으로 쌓는다 (같은 name 안에서 version 증가)
model PromptVersion {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  version     Int
  template    String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, name, version])
}

// 비교할 모델 설정. 가격은 100만 토큰당 USD
model ModelConfig {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  label           String
  provider        String
  model           String
  temperature     Float?
  maxTokens       Int?
  inputPricePerM  Float     @default(0)
  outputPricePerM Float     @default(0)
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
}
