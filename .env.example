# apps/api/.env 에 복사해서 사용 (.env 는 커밋하지 않음)
DATABASE_URL="postgresql://eval:eval@localhost:5432/evalboard"
JWT_SECRET="change-me"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# 실행 엔진 설정 (선택, 괄호 안은 기본값)
# LLM_CONCURRENCY=4        # 외부 API 동시 호출 수
# LLM_TIMEOUT_MS=60000     # 호출 1회 제한 시간
# LLM_MAX_ATTEMPTS=4       # 질문 1건당 최대 시도 횟수
# LLM_RETRY_BASE_MS=1000   # 재시도 대기 시간의 시작값
# LLM_RETRY_MAX_MS=15000   # 재시도 대기 시간의 상한
# LLM_RPM=0                # 모델당 분당 호출 수 제한 (0=제한 없음). 무료 티어 키는 5 로 설정
# LLM_RETRY_AFTER_MAX_MS=120000  # 제공자가 알려 준 429 대기 시간을 따르는 최대치

# 웹 화면 주소 (CORS 허용, 쉼표로 여러 개)
# WEB_ORIGIN=http://localhost:5173
# 로그 수준: debug | info | warn | error | silent
# LOG_LEVEL=info
